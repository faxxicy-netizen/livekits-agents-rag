# Local LiveKit development server. No LiveKit Cloud account is needed.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=knowledge-assistant

# Independent OpenAI-compatible endpoints. A chat-only provider does not imply audio support.
# Copy your provider's exact model names and base URLs. Keys stay on the Python server.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_THINKING=disabled
STT_BASE_URL=https://api.openai.com/v1
STT_PROVIDER=local
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_BASE_URL=https://api.openai.com/v1
TTS_PROVIDER=local
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Alibaba streaming speech: change both providers to dashscope and fill credentials locally.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
DASHSCOPE_TTS_VOICE=yuxiaoyun_v3.1
DASHSCOPE_TTS_RATE=1.05
DASHSCOPE_ASR_SILENCE_MS=400
DASHSCOPE_SPEECH_TIMEOUT=30

# Mandarin-specific Kokoro model, using the RTX GPU. No TTS API key required.
LOCAL_TTS_BACKEND=kokoro
LOCAL_TTS_VOICE=zf_001
LOCAL_TTS_DEVICE=cuda
LOCAL_TTS_SPEED=1.10

# For a local OpenAI-compatible server, set its URL and a nonempty placeholder key.
# Example LLM_BASE_URL=http://127.0.0.1:11434/v1 ; LLM_API_KEY=ollama

RAG_BACKEND=hybrid
VECTOR_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=support_knowledge
EMBEDDING_PROVIDER=local
# For a cloud deployment use dashscope and a NEW collection, then rebuild all vectors.
EMBEDDING_API_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
VECTOR_MIN_SCORE=0.42
RAG_TOP_K=3
RETRIEVAL_TIMEOUT_SECONDS=8
MODEL_TIMEOUT_SECONDS=35

# Optional Dify: fill these only when choosing the dify retriever.
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
DIFY_DATASET_ID=

APP_HOST=127.0.0.1
APP_PORT=8000

# Public deployment: internal LiveKit URL stays loopback; browser uses the public WSS URL.
LIVEKIT_PUBLIC_URL=
APP_PUBLIC_ORIGIN=
APP_SECURE_COOKIES=false
# Leave blank for the local demo. Public deployment MUST set a password hash and random secret.
APP_ACCESS_PASSWORD_HASH=
APP_SESSION_SECRET=
MAX_ACTIVE_CALLS=0
AGENT_IDLE_PROCESSES=1
